DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Listas separadas por vírgula; hosts sem esquema, origens com http:// ou https://.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
# HTTP local. Em produção: true (default quando DJANGO_DEBUG=false).
DJANGO_SECURE_SSL_REDIRECT=false
# Vazia usa POSTGRES_*; preenchida usa exclusivamente PostgreSQL com SSL obrigatório.
DATABASE_URL=
POSTGRES_DB=datasystemchallenge
POSTGRES_USER=datasystemchallenge
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
